# Copy this file to .env in the same folder, replace every value, then run: chmod 600 .env
# Do not commit .env, do not paste it into a chat or a ticket. Guide: docs/hosting.md
#
# The master secret is NOT in this file. It goes in a separate file called master_secret next to docker-compose.yml:
# one line of at least 32 characters (make one with:  openssl rand -hex 32 ), kept with an offline backup.

# The name the display will use, as in the display's "service address" setting: a host name, no https://, no port.
SERVICE_HOST=apis.example.com

# The credential for your DNS provider (Cloudflare shown: a token that may edit DNS records of your domain only).
CF_API_TOKEN=example-dns-token-REPLACE

# The Caddy module for your DNS provider. Cloudflare is the default; the list is at https://github.com/caddy-dns
DNS_MODULE=github.com/caddy-dns/cloudflare

# Optional. The image to run. The default is the public image, "latest". A commit tag pins one commit (not one build: the
# workflow can push the same tag again), for example
# LEDMATRIX_IMAGE=ghcr.io/suvl/ledmatrix-api:0123456789abcdef0123456789abcdef01234567

# Optional. Only if you build the image yourself for your own processor (docs/hosting.md, "The image"): the platform
# that `docker version --format '{{.Server.Os}}/{{.Server.Arch}}'` prints, for example linux/arm64. The default asks for the
# public image, which is linux/amd64.
# LEDMATRIX_IMAGE=ledmatrix-api:local
# LEDMATRIX_PLATFORM=linux/arm64

# Optional. Where the master secret file is, if not ./master_secret next to docker-compose.yml.
# MASTER_SECRET_PATH=./master_secret

# Optional. Device IDs the service refuses, comma separated (12 lowercase hex characters each).
# REVOKED_DEVICES=aabbccddeeff

# Optional. Only if a proxy in front of Caddy rewrites the Host header. Normally leave it out.
# PUBLIC_HOST=apis.example.com
